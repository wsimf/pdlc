# Copy this file to `live_config.toml` (git-ignored) and fill in real,
# disposable scratch identifiers to run the live E2E suites. Each table is
# independent: `test_github_e2e.py` skips unless `[github]` is present,
# `test_azure_e2e.py` skips unless `[azure]` is present.

[github]
repository = "OWNER/REPOSITORY"
project_owner = "OWNER"
project_number = "1"

[azure]
organization = "https://dev.azure.com/ORG"
project = "SCRATCH-PROJECT"
# Optional; defaults match a Scrum-derived process.
record_type = "User Story"
closed_state = "Closed"
open_state = "New"
